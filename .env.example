# ── med360-agent — Variables de Entorno ──────────────
# Copia este archivo a .env y configura tus valores

# ── n8n ──────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# ── LLM (elegir al menos uno) ────────────────────────
OPENAI_API_KEY=sk-your-key-here
# GOOGLE_API_KEY=your-google-ai-studio-key
# COHERE_API_KEY=your-cohere-key

# ── Embeddings ────────────────────────────────────────
# Opciones: sentence_transformers (local, sin API key)
#           openai | google | cohere
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Qdrant ────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=med360_knowledge

# ── Knowledge API ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
SEARCH_TOP_K=5
LOG_LEVEL=INFO

# ── Dominio (producción) ──────────────────────────────
# DOMAIN=agente.medicamentum360.com
